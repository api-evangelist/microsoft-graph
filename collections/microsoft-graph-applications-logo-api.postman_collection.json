    "name": "Microsoft Graph Admin Admin.admin Applications Logo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Microsoft Graph API for managing administrative resources in Microsoft Entra ID.\nThis API enables administrators to manage Microsoft Edge browser settings, Internet Explorer mode configurations,\nsite lists, shared browser sites, Microsoft 365 Apps installation options, people insights, service announcements,\nSharePoint settings, Copilot administration, directory administrative units, and admin consent policies.\n\nContact Support:\n Name: Microsoft Graph API Support",
      "type": "text/plain"
    }
  }
