          "id": "38138617-b834-4284-9d08-4e6e77fddc7b",
          "name": "Microsoft Graph Create Check Member Groups",
          "request": {
            "name": "Microsoft Graph Create Check Member Groups",
            "description": {
              "content": "Check for membership in a specified list of group IDs, and return from that list the IDs of groups where a specified object is a member. The specified object can be of one of the following types:\r\n- user\r\n- group\r\n- service principal\r\n- organizational contact\r\n- device\r\n- directory object This function is transitive. You can check up to a maximum of 20 groups per request. This function supports all groups provisioned in Microsoft Entra ID. Because Microsoft 365 groups cannot contain other groups, membership in a Microsoft 365 group is always direct.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "applications",
                ":application-id",
                "checkMemberGroups"
