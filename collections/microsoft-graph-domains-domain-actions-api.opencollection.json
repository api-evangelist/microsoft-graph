                "description": "The unique identifier of domain"
              }
            ]
          },
          "docs": "Promote a verified subdomain to the root domain. A verified domain has its isVerified property set to true."
        },
        {
          "info": {
            "name": "Microsoft Graph Invoke action verify",
            "type": "http"
          },
